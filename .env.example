# Copy this file to ".env" in the project root and fill in the key. ".env" is ignored by Git.
# Start the companion with: .\scripts\run-companion.ps1
# Simple KEY=VALUE lines. Optional quotes around a value are removed. Whole-line comments only.

# Address of the provider (POST {base}/chat/completions). https is required, except for this computer.
PRESENTA_AI_BASE_URL=https://api.openai.com/v1
# Model name. Prefer a small non-reasoning chat model.
PRESENTA_AI_MODEL=gpt-5.6-luna
# Your key. Never commit it and never paste it anywhere else.
PRESENTA_AI_API_KEY=

# ---- Optional request settings (the two recommended ones are on; the others show their defaults) ----
# Name of the token-limit field: max_completion_tokens or max_tokens.
# PRESENTA_AI_TOKEN_PARAM=max_completion_tokens
# Token limit, 16 to 8000. Reasoning models count their hidden reasoning inside it.
# If the provider rejects this value, delete the line or lower it.
PRESENTA_AI_MAX_TOKENS=800
# A number from 0 to 2. Setting it sends "temperature"; leave unset for reasoning models.
# PRESENTA_AI_TEMPERATURE=0.2
# A word such as none, minimal or low. Setting it sends "reasoning_effort"; "none" keeps reasoning models fast.
# If the provider rejects it, delete the line (one rejected request is retried without it, then the shape is remembered).
PRESENTA_AI_REASONING_EFFORT=none
# Seconds to wait for one answer, 1 to 30.
# PRESENTA_AI_TIMEOUT_SECONDS=8
