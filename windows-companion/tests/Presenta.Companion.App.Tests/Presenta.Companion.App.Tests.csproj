<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the WPF layer. They run on an STA thread and render controls offscreen: no window is ever created or shown.
    The optional picture export is skipped unless PRESENTA_DESKTOP_TESTS is set to 1.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Presenta.Companion.App\Presenta.Companion.App.csproj" />
    <ProjectReference Include="..\..\src\Presenta.Companion.ViewModels\Presenta.Companion.ViewModels.csproj" />
    <ProjectReference Include="..\..\src\Presenta.Server\Presenta.Server.csproj" />
    <ProjectReference Include="..\..\src\Presenta.Targeting\Presenta.Targeting.csproj" />
    <ProjectReference Include="..\..\src\Presenta.Domain\Presenta.Domain.csproj" />
    <ProjectReference Include="..\Presenta.TestSupport\Presenta.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
