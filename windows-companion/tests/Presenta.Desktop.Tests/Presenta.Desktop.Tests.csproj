<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Opt-in tests that need an interactive Windows desktop: they open real windows and press real arrow keys into them.
    They are skipped unless the environment variable PRESENTA_DESKTOP_TESTS is set to 1.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Presenta.Keyboard.Windows\Presenta.Keyboard.Windows.csproj" />
    <ProjectReference Include="..\..\src\Presenta.Targeting\Presenta.Targeting.csproj" />
    <ProjectReference Include="..\..\src\Presenta.Domain\Presenta.Domain.csproj" />
    <ProjectReference Include="..\Presenta.WindowProbe\Presenta.WindowProbe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
