<Window x:Class="Presenta.Companion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Presenta.Companion.ViewModels;assembly=Presenta.Companion.ViewModels"
        xmlns:views="clr-namespace:Presenta.Companion.App.Views"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Labels.Title}"
        Width="1040" Height="680" MinWidth="900" MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="Assets/presenta.ico"
        UseLayoutRounding="True">
    <views:ShellView />
</Window>
