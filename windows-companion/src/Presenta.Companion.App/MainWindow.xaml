<Window x:Class="Presenta.Companion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Presenta.Companion.ViewModels;assembly=Presenta.Companion.ViewModels"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Labels.Title}"
        Width="780" Height="760" MinWidth="600" MinHeight="560"
        Background="{StaticResource NightBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title, server state, start/stop -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Labels.Title}" FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource WarmWhiteBrush}" />
                    <TextBlock Text="{Binding Labels.Subtitle}" Style="{StaticResource Hint}" FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource CyanBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ServerStatusText}" Style="{StaticResource Body}" FontSize="14"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Content="{Binding ToggleServerText}" Command="{Binding ToggleServerCommand}"
                            Style="{StaticResource SecondaryPillButton}" />
                </StackPanel>
            </Grid>

            <!-- Pairing and connection -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.4*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Labels.PairingTitle}" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding PairingCode}" FontFamily="Consolas" FontSize="54" FontWeight="Bold"
                                   Foreground="{StaticResource CyanBrush}" Margin="0,0,0,4"
                                   AutomationProperties.Name="{Binding Labels.PairingTitle}" />
                        <TextBlock Text="{Binding Labels.PairingHint}" Style="{StaticResource Hint}" Margin="0,0,0,16" />
                        <Button Content="{Binding Labels.PairingRegenerate}" Command="{Binding RegenerateCodeCommand}"
                                Style="{StaticResource SecondaryPillButton}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Labels.ConnectionTitle}" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding PortText}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Addresses}" Margin="0,0,0,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Hint}" FontFamily="Consolas"
                                               Foreground="{StaticResource WarmWhiteBrush}" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox Style="{StaticResource Switch}" Content="{Binding Labels.LocalNetworkToggle}"
                                  IsChecked="{Binding AllowLocalNetwork, Mode=TwoWay}" />
                        <TextBlock Text="{Binding Labels.LocalNetworkHint}" Style="{StaticResource Hint}" Margin="56,2,0,14" />

                        <CheckBox Style="{StaticResource Switch}" Content="{Binding Labels.SendKeysToggle}"
                                  IsChecked="{Binding SendKeys, Mode=TwoWay}" />
                        <TextBlock Text="{Binding Labels.SendKeysHint}" Style="{StaticResource Hint}" Margin="56,2,0,0" />

                        <TextBlock Text="{Binding ServerError}" Foreground="{StaticResource RedBrush}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,14,0,0"
                                   Visibility="{Binding HasServerError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Presentation window: where the keys go -->
            <Border Grid.Row="2" Style="{StaticResource Card}"
                    Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DataContext="{Binding Target}">
                    <TextBlock Text="{Binding DataContext.Labels.TargetTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding DataContext.Labels.TargetHint, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource Hint}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding DataContext.Labels.TargetKeysOff, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{StaticResource AmberBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding KeysOffNoteVisible, Converter={StaticResource BoolToVisibility}}" />

                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             DisplayMemberPath="Display" MaxHeight="170" Background="{StaticResource NightBrush}"
                             Foreground="{StaticResource WarmWhiteBrush}" BorderThickness="0" FontSize="14"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="4" />
                    <TextBlock Text="{Binding DataContext.Labels.TargetEmpty, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource Hint}" FontSize="13" Margin="4,6,0,0"
                               Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                        <Button Content="{Binding DataContext.Labels.TargetRefresh, RelativeSource={RelativeSource AncestorType=Window}}"
                                Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryPillButton}" Margin="0,0,10,0" />
                        <Button Content="{Binding DataContext.Labels.TargetVerify, RelativeSource={RelativeSource AncestorType=Window}}"
                                Command="{Binding VerifyCommand}" Style="{StaticResource PillButton}" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGood}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Watch, session and recent activity -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.4*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Labels.WatchTitle}" Style="{StaticResource Heading}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WatchConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource CyanBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding WatchStatusText}" Style="{StaticResource Body}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Labels.SessionTitle}" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding Labels.SessionNone}" Style="{StaticResource Hint}" FontSize="14"
                                   Visibility="{Binding HasNoSession, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SessionName}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SessionSlideText}" Foreground="{StaticResource CyanBrush}"
                                       FontSize="22" FontWeight="Bold" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding SessionRemainingText}" FontSize="15" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SessionOvertime}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Labels.SessionPaused}" Foreground="{StaticResource AmberBrush}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Visibility="{Binding SessionPaused, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Labels.EventsTitle}" Style="{StaticResource Heading}" />
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="14" Margin="0,0,0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
