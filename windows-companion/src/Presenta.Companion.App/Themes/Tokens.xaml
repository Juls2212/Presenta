<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Design tokens of the desktop window (graphite background, glass panels, cyan accent).
        This is the only file of the app that contains color values. Every other file refers to these keys, so the
        contrast test (DesignTokenContrastTests) and the high-contrast fallback (HighContrastTokens) see all of them.
    -->

    <!-- ===== Colors ===== -->
    <Color x:Key="Graphite1">#14161B</Color>
    <Color x:Key="Graphite2">#1C2028</Color>
    <Color x:Key="Ink">#ECEFF4</Color>
    <Color x:Key="Muted">#A3ABBA</Color>
    <Color x:Key="Dim">#8A93A5</Color>
    <Color x:Key="Cyan">#22D3EE</Color>
    <Color x:Key="Amber">#FFB020</Color>
    <Color x:Key="Orange">#FF8A3D</Color>
    <Color x:Key="Red">#FF5C5C</Color>
    <Color x:Key="Ok">#5BE3A0</Color>

    <!-- Text and marks drawn on top of an accent fill -->
    <Color x:Key="OnCyan">#04222A</Color>
    <Color x:Key="OnOk">#06231A</Color>
    <Color x:Key="OnAmber">#2A1A00</Color>
    <Color x:Key="OnRed">#2A0808</Color>

    <!-- Translucent layers (alpha is part of the value) -->
    <Color x:Key="Glass">#0EFFFFFF</Color>
    <Color x:Key="GlassStrong">#17FFFFFF</Color>
    <Color x:Key="GlassHover">#24FFFFFF</Color>
    <Color x:Key="GlassLine">#1AFFFFFF</Color>
    <Color x:Key="GlassHighlight">#38FFFFFF</Color>
    <Color x:Key="CyanSoft">#2422D3EE</Color>
    <Color x:Key="AmberSoft">#14FFB020</Color>
    <Color x:Key="Scrim">#47000000</Color>
    <Color x:Key="RingInner">#20242D</Color>
    <Color x:Key="RingTrack">#1AFFFFFF</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
    <SolidColorBrush x:Key="Graphite1Brush" Color="{StaticResource Graphite1}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
    <SolidColorBrush x:Key="DimBrush" Color="{StaticResource Dim}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource Cyan}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource Amber}" />
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource Orange}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource Ok}" />
    <SolidColorBrush x:Key="OnCyanBrush" Color="{StaticResource OnCyan}" />
    <SolidColorBrush x:Key="OnOkBrush" Color="{StaticResource OnOk}" />
    <SolidColorBrush x:Key="OnAmberBrush" Color="{StaticResource OnAmber}" />
    <SolidColorBrush x:Key="OnRedBrush" Color="{StaticResource OnRed}" />
    <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource Glass}" />
    <SolidColorBrush x:Key="GlassStrongBrush" Color="{StaticResource GlassStrong}" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="{StaticResource GlassHover}" />
    <SolidColorBrush x:Key="GlassLineBrush" Color="{StaticResource GlassLine}" />
    <SolidColorBrush x:Key="CyanSoftBrush" Color="{StaticResource CyanSoft}" />
    <SolidColorBrush x:Key="AmberSoftBrush" Color="{StaticResource AmberSoft}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource Scrim}" />
    <SolidColorBrush x:Key="RingInnerBrush" Color="{StaticResource RingInner}" />
    <SolidColorBrush x:Key="RingTrackBrush" Color="{StaticResource RingTrack}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <!-- Window background: graphite with two soft glows -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Graphite1}" Offset="0" />
        <GradientStop Color="{StaticResource Graphite2}" Offset="1" />
    </LinearGradientBrush>

    <!-- Left rail: a little lighter than the window -->
    <SolidColorBrush x:Key="RailBrush" Color="{StaticResource Glass}" />

    <!-- Thin light border of a glass panel: brighter on top, so the panel seems lit from above -->
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GlassHighlight}" Offset="0" />
        <GradientStop Color="{StaticResource GlassLine}" Offset="0.35" />
        <GradientStop Color="{StaticResource GlassLine}" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Shape, spacing and typography ===== -->
    <CornerRadius x:Key="RadiusPanel">20</CornerRadius>
    <CornerRadius x:Key="RadiusControl">10</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">16</CornerRadius>

    <Thickness x:Key="PagePadding">30,26,30,30</Thickness>
    <Thickness x:Key="PanelPadding">26</Thickness>
    <Thickness x:Key="GapSmall">0,0,0,8</Thickness>
    <Thickness x:Key="GapMedium">0,0,0,16</Thickness>
    <Thickness x:Key="GapLarge">0,0,0,24</Thickness>

    <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SizeTitle">26</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SizeBody">15</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SizeSmall">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SizeHeading">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SizeDigit">38</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SizeRing">40</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="MinTarget">36</sys:Double>
</ResourceDictionary>
