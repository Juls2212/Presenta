<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:Presenta.Companion.App">
    <!-- Styles built only from the tokens of Tokens.xaml. No color value appears in this file. -->

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <app:SectionIconConverter x:Key="SectionIcon" />
    <app:ToneConverter x:Key="Tone" />
    <app:FractionOfWidthConverter x:Key="FractionOfWidth" />
    <app:PercentToArcConverter x:Key="PercentToArc" />
    <app:NegativeHalfConverter x:Key="NegativeHalf" />
    <app:MarkerMarginConverter x:Key="MarkerMargin" />
    <app:InverseBooleanToVisibilityConverter x:Key="NotToVisibility" />

    <!-- ===== Icons (24 x 24 grid, stroked) ===== -->
    <Geometry x:Key="Icon_Home">M4,11 L12,4 L20,11 L20,19 A1,1 0 0 1 19,20 L15,20 L15,14 L9,14 L9,20 L5,20 A1,1 0 0 1 4,19 Z</Geometry>
    <Geometry x:Key="Icon_Pair">M10,14 A4,4 0 0 0 15.7,14 L18.7,11 A4,4 0 0 0 13,5.3 L12,6.3 M14,10 A4,4 0 0 0 8.3,10 L5.3,13 A4,4 0 0 0 11,18.7 L12,17.7</Geometry>
    <Geometry x:Key="Icon_Window">M5,5 L19,5 A2,2 0 0 1 21,7 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 L3,7 A2,2 0 0 1 5,5 Z M3,9 L21,9</Geometry>
    <Geometry x:Key="Icon_Ai">M12,3 L13.8,7.6 L18,9 L13.8,10.4 L12,15 L10.2,10.4 L6,9 L10.2,7.6 Z</Geometry>
    <Geometry x:Key="Icon_Activity">M4,6 L20,6 M4,12 L20,12 M4,18 L14,18</Geometry>
    <Geometry x:Key="Icon_Settings">M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z M12,3 L12,6 M12,18 L12,21 M3,12 L6,12 M18,12 L21,12 M5.6,5.6 L7.7,7.7 M16.3,16.3 L18.4,18.4 M5.6,18.4 L7.7,16.3 M16.3,7.7 L18.4,5.6</Geometry>
    <Geometry x:Key="Icon_NodeWatch">M10,2 L14,2 L14,5 L10,5 Z M10,19 L14,19 L14,22 L10,22 Z M10,6 L14,6 A4,4 0 0 1 18,10 L18,14 A4,4 0 0 1 14,18 L10,18 A4,4 0 0 1 6,14 L6,10 A4,4 0 0 1 10,6 Z</Geometry>
    <Geometry x:Key="Icon_NodeComputer">M5,4 L19,4 A2,2 0 0 1 21,6 L21,14 A2,2 0 0 1 19,16 L5,16 A2,2 0 0 1 3,14 L3,6 A2,2 0 0 1 5,4 Z M8,20 L16,20 M12,16 L12,20</Geometry>
    <Geometry x:Key="Icon_NodePresentation">M5,4 L19,4 A2,2 0 0 1 21,6 L21,15 A2,2 0 0 1 19,17 L5,17 A2,2 0 0 1 3,15 L3,6 A2,2 0 0 1 5,4 Z M8,9 L12,12 L8,15</Geometry>
    <Geometry x:Key="Icon_Check">M3,8 L7,12 L13,4</Geometry>
    <Geometry x:Key="Icon_Bang">M8,3 L8,9 M8,12.5 L8,12.6</Geometry>
    <Geometry x:Key="Icon_Chevron">M2,4 L6,8 L10,4</Geometry>
    <Geometry x:Key="Icon_ChevronRight">M4,2 L8,6 L4,10</Geometry>
    <Geometry x:Key="Icon_Up">M2,7 L6,3 L10,7</Geometry>
    <Geometry x:Key="Icon_Down">M2,3 L6,7 L10,3</Geometry>

    <!-- ===== Keyboard focus: a cyan ring on every interactive element ===== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="10" RadiusY="10" StrokeThickness="2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource CyanBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text ===== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontSize" Value="{StaticResource SizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageLead" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="620" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,22" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
        <Setter Property="FontSize" Value="{StaticResource SizeHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="{StaticResource SizeSmall}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
        <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource GlassLineBrush}" />
        <Setter Property="Margin" Value="0,22" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Foreground" Value="{DynamicResource OnCyanBrush}" />
        <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small square button of the minutes stepper -->
    <Style x:Key="StepButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{DynamicResource TransparentBrush}">
                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassStrongBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Marks: shape and color together ===== -->
    <!-- Small dot (navigation, activity): filled circle = ready, triangle = attention, ring = off or waiting, diamond = problem. -->
    <Style x:Key="DotMark" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Width="12" Height="12">
                        <Ellipse x:Name="OkShape" Fill="{DynamicResource OkBrush}" Visibility="Collapsed" />
                        <Path x:Name="WarnShape" Data="M6,0 L12,11 L0,11 Z" Fill="{DynamicResource AmberBrush}" Visibility="Collapsed" />
                        <Ellipse x:Name="OffShape" Stroke="{DynamicResource DimBrush}" StrokeThickness="1.6" Margin="1" Visibility="Collapsed" />
                        <Rectangle x:Name="BadShape" Fill="{DynamicResource RedBrush}" Width="8" Height="8" Visibility="Collapsed"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource Tone}}" Value="Ok">
                            <Setter TargetName="OkShape" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource Tone}}" Value="Warn">
                            <Setter TargetName="WarnShape" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource Tone}}" Value="Off">
                            <Setter TargetName="OffShape" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource Tone}}" Value="Bad">
                            <Setter TargetName="BadShape" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round mark of the checklist: check on green = ready, exclamation on amber = attention, empty ring = pending. -->
    <Style x:Key="CheckMark" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Width="28" Height="28">
                        <Ellipse x:Name="OkDisc" Fill="{DynamicResource OkBrush}" Visibility="Collapsed" />
                        <Path x:Name="OkGlyph" Data="{StaticResource Icon_Check}" Stroke="{DynamicResource OnOkBrush}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Ellipse x:Name="WarnDisc" Fill="{DynamicResource AmberBrush}" Visibility="Collapsed" />
                        <Path x:Name="WarnGlyph" Data="{StaticResource Icon_Bang}" Stroke="{DynamicResource OnAmberBrush}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Ellipse x:Name="EmptyRing" Stroke="{DynamicResource DimBrush}" StrokeThickness="2" Margin="1" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource Tone}}" Value="Ok">
                            <Setter TargetName="OkDisc" Property="Visibility" Value="Visible" />
                            <Setter TargetName="OkGlyph" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource Tone}}" Value="Warn">
                            <Setter TargetName="WarnDisc" Property="Visibility" Value="Visible" />
                            <Setter TargetName="WarnGlyph" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource Tone}}" Value="Off">
                            <Setter TargetName="EmptyRing" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navigation rail item ===== -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Surface" Background="{DynamicResource TransparentBrush}" CornerRadius="{StaticResource RadiusControl}" />
                        <Border x:Name="Bar" Width="3" Margin="0,10" HorizontalAlignment="Left" CornerRadius="2"
                                Background="{DynamicResource CyanBrush}" Visibility="Collapsed" />
                        <Grid Margin="14,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Data="{Binding Section, Converter={StaticResource SectionIcon}}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontSize="14.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentControl Grid.Column="2" Style="{StaticResource DotMark}" Content="{Binding Status}"
                                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="{Binding StatusText}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassStrongBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== A row of the checklist (a whole-row button) ===== -->
    <Style x:Key="CheckRow" TargetType="Button">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{DynamicResource TransparentBrush}" CornerRadius="12" Padding="10,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource CheckMark}" Content="{Binding State}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Path Grid.Column="2" Data="{StaticResource Icon_ChevronRight}" Stroke="{DynamicResource DimBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="10,0,2,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== A window of the list: one choice among many, with a round mark ===== -->
    <Style x:Key="WindowRow" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsSelected" Value="{Binding IsChosen, Mode=TwoWay}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Surface" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource TransparentBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource DimBrush}" StrokeThickness="2" />
                                <Ellipse x:Name="Disc" Fill="{DynamicResource CyanBrush}" Visibility="Collapsed" />
                                <Path x:Name="Tick" Data="{StaticResource Icon_Check}" Stroke="{DynamicResource OnCyanBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="11" Height="9"
                                      Visibility="Collapsed" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center" FontSize="14.5" TextWrapping="Wrap"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CyanSoftBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                            <Setter TargetName="Disc" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowList" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource WindowRow}" />
    </Style>

    <!-- ===== Expander with a plain, readable header ===== -->
    <Style x:Key="PlainExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="Header" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      MinHeight="36" Cursor="Hand" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}"
                                      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Surface" Background="{DynamicResource TransparentBrush}" CornerRadius="{StaticResource RadiusSmall}"
                                            Padding="4,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="Arrow" Data="{StaticResource Icon_ChevronRight}" Stroke="{DynamicResource MutedBrush}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                              TextElement.FontWeight="SemiBold" TextElement.FontSize="14.5"
                                                              TextElement.Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Switch: a check box drawn as a switch ===== -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="{DynamicResource TransparentBrush}">
                        <Grid Width="44" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="12" Background="{DynamicResource GlassHoverBrush}"
                                    BorderBrush="{DynamicResource DimBrush}" BorderThickness="1" />
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="4,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource InkBrush}" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource CyanBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource OnCyanBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A digit box of the pairing code -->
    <Style x:Key="DigitBox" TargetType="Border">
        <Setter Property="Width" Value="58" />
        <Setter Property="Height" Value="76" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
    </Style>

    <!-- Status line (live region text) -->
    <Style x:Key="StatusLine" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    </Style>
    <!-- ===== Brand logo: the application icon artwork as vectors (rounded square, track ring, 300-degree cyan arc, center dot) ===== -->
    <Style x:Key="BrandLogo" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform" SnapsToDevicePixels="False" UseLayoutRounding="False">
                        <Canvas Width="100" Height="100">
                            <Rectangle Width="100" Height="100" RadiusX="22" RadiusY="22" Fill="{DynamicResource Graphite1Brush}" />
                            <Ellipse Canvas.Left="20" Canvas.Top="20" Width="60" Height="60" Stroke="{DynamicResource RingTrackBrush}" StrokeThickness="11" />
                            <Path Data="M50,20 A30,30 0 1 1 24.02,35" Stroke="{DynamicResource CyanBrush}" StrokeThickness="11"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="40" Canvas.Top="40" Width="20" Height="20" Fill="{DynamicResource InkBrush}" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
