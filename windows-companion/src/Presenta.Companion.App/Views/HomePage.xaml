<UserControl x:Class="Presenta.Companion.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Presenta.Companion.ViewModels;assembly=Presenta.Companion.ViewModels">
    <!-- The shell gives this page at least the visible height: the content is centered in it, up to a maximum width -->
    <StackPanel VerticalAlignment="Center" MaxWidth="900">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{Binding Lead}" Style="{StaticResource PageLead}" />

        <!-- One glass panel, two halves -->
        <Border Style="{StaticResource GlassPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="300" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="0.9*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!-- Left: Antes de empezar -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Main.Labels.HomeChecklist}" Style="{StaticResource SectionHeading}" />
                    <ItemsControl ItemsSource="{Binding Main.Checklist}" KeyboardNavigation.DirectionalNavigation="Contained">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChecklistItemViewModel}">
                                <Button Style="{StaticResource CheckRow}" Command="{Binding Command}"
                                        AutomationProperties.Name="{Binding AutomationName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Right: the session in progress, or an empty state -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Main.Labels.HomeSession}" Style="{StaticResource SectionHeading}" HorizontalAlignment="Center" />

                    <StackPanel Visibility="{Binding Main.HasSession, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center">
                        <Grid Width="176" Height="176" Margin="0,0,0,14" AutomationProperties.Name="{Binding Main.SessionRingName}"
                              AutomationProperties.LiveSetting="Off">
                            <Ellipse Stroke="{DynamicResource RingTrackBrush}" StrokeThickness="14" Margin="7" />
                            <Path Data="{Binding Main.SessionProgressPercent, Converter={StaticResource PercentToArc}, ConverterParameter='88;81'}"
                                  StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="{DynamicResource CyanBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Main.SessionOvertime}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource RedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Main.SessionCurrentSlide}" FontSize="{StaticResource SizeRing}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock FontSize="18" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,6">
                                        <Run Text="/ " /><Run Text="{Binding Main.SessionTotalSlides, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding Main.Labels.HomeSlideCaption}" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Main.SessionName}" Style="{StaticResource Hint}" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Margin="0,0,26,0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Main.SessionElapsedText}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Main.Labels.HomeElapsedCaption}" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" AutomationProperties.Name="{Binding Main.SessionRemainingText}">
                                <TextBlock Text="{Binding Main.SessionRemainingClock}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Main.SessionOvertime}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Main.Labels.HomeRemainingCaption}" Style="{StaticResource Hint}" HorizontalAlignment="Center"
                                           Visibility="{Binding Main.SessionOvertime, Converter={StaticResource NotToVisibility}}" />
                                <TextBlock Text="{Binding Main.Labels.HomeOvertimeCaption}" Style="{StaticResource Hint}" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource RedBrush}"
                                           Visibility="{Binding Main.SessionOvertime, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Pace pill: a mark, then the words -->
                        <Border CornerRadius="{StaticResource RadiusPill}" Padding="14,7" Margin="0,14,0,0" HorizontalAlignment="Center"
                                BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DimBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Main.PaceTone}" Value="Warning">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                            <Setter Property="Background" Value="{DynamicResource AmberSoftBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Main.PaceTone}" Value="Good">
                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource DotMark}" Content="{Binding Main.PaceTone}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Main.PaceText}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Main.Labels.SessionPaused}" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"
                                   Visibility="{Binding Main.SessionPaused, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- Empty state -->
                    <StackPanel Visibility="{Binding Main.HasNoSession, Converter={StaticResource BoolToVisibility}}" MaxWidth="260"
                                HorizontalAlignment="Center">
                        <Grid Width="96" Height="96" Margin="0,6,0,14" HorizontalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource RingTrackBrush}" StrokeThickness="10" Margin="5" />
                        </Grid>
                        <TextBlock Text="{Binding Main.Labels.SessionNone}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="{Binding Main.Labels.HomeNoSessionHint}" Style="{StaticResource Hint}" TextAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Recent activity, without a card -->
        <StackPanel Margin="0,26,0,0">
            <TextBlock Text="{Binding Main.Labels.EventsTitle}" Style="{StaticResource SectionHeading}" />
            <TextBlock Text="{Binding Main.Labels.EventsEmpty}" Style="{StaticResource Hint}" Margin="0,0,0,8"
                       Visibility="{Binding Main.HasNoEntries, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Main.RecentEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ActivityEntryViewModel}">
                        <Grid Margin="0,0,0,2" MinHeight="36" AutomationProperties.Name="{Binding Line}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Time}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            <ContentControl Grid.Column="1" Style="{StaticResource DotMark}" Content="{Binding Tone}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Body}" FontSize="14.5" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{Binding Main.Labels.HomeSeeAll}" Command="{Binding Main.Navigation.ActivityCommand}"
                    Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
