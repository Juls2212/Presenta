<UserControl x:Class="Presenta.Companion.App.Views.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Presenta.Companion.ViewModels;assembly=Presenta.Companion.ViewModels">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{Binding Lead}" Style="{StaticResource PageLead}" />

        <Border Style="{StaticResource GlassPanel}">
            <StackPanel>
                <TextBlock Text="{Binding Main.Labels.EventsEmpty}" Style="{StaticResource Hint}" FontSize="14"
                           Visibility="{Binding Main.HasNoEntries, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Main.ActivityEntries}" AutomationProperties.Name="{Binding Main.Labels.EventsTitle}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ActivityEntryViewModel}">
                            <Grid MinHeight="40" AutomationProperties.Name="{Binding Line}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <ContentControl Grid.Column="1" Style="{StaticResource DotMark}" Content="{Binding Tone}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Body}" FontSize="14.5" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
