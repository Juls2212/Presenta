{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presenta.local/protocol/v1/error.schema.json",
  "title": "error (companion to watch)",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "type": { "const": "error" },
    "payload": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/errorCode" },
        "message": { "type": "string", "description": "Developer-facing English text. Never shown to the presenter." },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  }
}
