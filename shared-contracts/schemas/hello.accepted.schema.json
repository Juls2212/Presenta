{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presenta.local/protocol/v1/hello.accepted.schema.json",
  "title": "hello.accepted (companion to watch)",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "type": { "const": "hello.accepted" },
    "payload": {
      "type": "object",
      "required": ["protocolVersion", "state"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "state": { "$ref": "common.schema.json#/$defs/statePayload" }
      }
    }
  }
}
