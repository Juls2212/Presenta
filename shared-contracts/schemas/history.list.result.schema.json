{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presenta.local/protocol/v1/history.list.result.schema.json",
  "title": "history.list.result (companion to watch)",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "type": { "const": "history.list.result" },
    "payload": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/historyItem" }
        }
      }
    }
  }
}
